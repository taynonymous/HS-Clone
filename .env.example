# Basic auth for the UI/API (user defaults to "admin"). Set this if the port is reachable by anyone else.
APP_PASSWORD=
APP_USER=admin

# Seed values for settings on first boot (editable later in the UI).
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
DISCORD_WEBHOOK_URL=
WEBHOOK_URL=
BESTBUY_API_KEY=

# Floor for per-item polling interval.
MIN_INTERVAL_SEC=15
# Set to 0 to skip seeding the PS5 Pro watchlist on first boot.
SEED_PS5_PRO=1
