{
  "manifest_version": 3,
  "name": "HS-Clone Checkout Assist",
  "version": "0.1.0",
  "description": "Opens the cart when HS-Clone detects a restock and walks checkout to the review page. You place the order.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "notifications", "tabs", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "HS-Clone Checkout Assist" },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://www.bestbuy.com/*",
        "https://api.bestbuy.com/click/*",
        "https://www.amazon.com/*",
        "https://direct.playstation.com/*",
        "https://my.account.sony.com/*"
      ],
      "js": ["flows.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
